{
  "manifest_version": 3,
  "name": "UBCMS URL Switcher",
  "version": "1.0.0",
  "description": "Switch UBCMS environments and AEM views, or translate live Buffalo URLs.",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "UBCMS URL Switcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
